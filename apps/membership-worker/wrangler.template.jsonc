// Rendered to wrangler.jsonc by tooling/wire/render.mjs (BF6 deploy-time wiring).
// Resource IDs are NEVER committed: @@wiring(<component>/<env>:<key>)@@ tokens are
// resolved from the workspace's orun secrets at deploy time (wire-live) or from the
// committed wiring.fixture.json for offline dry-runs (wire-fixture).
{
  "name": "meterwise-membership-worker",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "minify": false,
  "vars": {
    "ENVIRONMENT": "local",
    "DEBUG_DELIVERY": "true",
    // Solo profile OFF: a product team shares one organization, and an
    // agency may run several. Must match api-edge/identity-worker/membership-worker.
    "SOLO_MODE": "false"
  },
  "env": {
    "dev": {
      "vars": {
        "ENVIRONMENT": "dev",
        "DEBUG_DELIVERY": "true",
        "SOLO_MODE": "false"
      }
    },
    "stage": {
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "stage",
        "DEBUG_DELIVERY": "true",
        "SOLO_MODE": "false"
      },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "meterwise-stage",
          "database_id": "@@wiring(cloudflare-d1/stage:d1_database_id)@@"
        }
      ],
      "services": [
        {
          "binding": "POLICY_WORKER",
          "service": "meterwise-policy-worker-stage"
        },
        {
          "binding": "BILLING_WORKER",
          "service": "meterwise-billing-worker-stage"
        },
        {
          "binding": "NOTIFICATIONS_WORKER",
          "service": "meterwise-notifications-worker-stage"
        }
      ]
    },
    "prod": {
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "prod",
        "DEBUG_DELIVERY": "false",
        "SOLO_MODE": "false"
      },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "meterwise-prod",
          "database_id": "@@wiring(cloudflare-d1/prod:d1_database_id)@@"
        }
      ],
      "services": [
        {
          "binding": "POLICY_WORKER",
          "service": "meterwise-policy-worker-prod"
        },
        {
          "binding": "BILLING_WORKER",
          "service": "meterwise-billing-worker-prod"
        },
        {
          "binding": "NOTIFICATIONS_WORKER",
          "service": "meterwise-notifications-worker-prod"
        }
      ]
    }
  }
}

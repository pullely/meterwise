{
  "extends": "../../tooling/tsconfig/base.json",
  "compilerOptions": {
    "types": ["jest", "node", "@cloudflare/workers-types"],
    "allowSyntheticDefaultImports": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "baseUrl": ".",
    "paths": {
      "@saas/contracts": ["../../packages/contracts/src/index.ts"],
      "@saas/contracts/*": ["../../packages/contracts/src/*.ts"],
      "@saas/db": ["../../packages/db/src/index.ts"],
      "@saas/db/manifest": ["../../packages/db/src/manifest.ts"],
      "@saas/db/types": ["../../packages/db/src/types.ts"],
      "@saas/db/*": ["../../packages/db/src/*/index.ts"],
      "@saas/notifications-client": ["../../packages/notifications-client/src/index.ts"],
      "@ledger-worker/*": ["../../apps/ledger-worker/src/*.ts"]
    }
  },
  "include": ["src/**/*.ts", "../../apps/ledger-worker/src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
